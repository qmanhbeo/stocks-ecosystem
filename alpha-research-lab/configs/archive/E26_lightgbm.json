{
    "experiment_name": "E26_lightgbm",
    "note": "V9: E8 features with LightGBM instead of XGBoost. Different regularization, handles mixed feature types better. Direct comparison to E8.",
    "data": {
        "file_path": "data/stock/gia_lich_su_FPT_1D.parquet",
        "target_col": "future_rel_dir_5d",
        "test_size": 0.15, "val_size": 0.15, "start_date": "2016-01-01"
    },
    "features": {
        "base_cols": [],
        "use_lags": false,
        "use_ma": false, "use_ma_dist": true, "ma_windows": [5, 10, 20, 50],
        "use_rsi": true,
        "use_macd": true,
        "use_bb": true,
        "use_atr": true,
        "use_candle": true,
        "use_stoch": true,
        "use_willr": false, "use_adx": true,
        "use_hist_vol": true, "hist_vol_windows": [5, 10, 20],
        "use_cci": false,
        "use_volume_signals": false,
        "use_market_relative": true,
        "index_file": "data/stock/gia_lich_su_VNINDEX_1D.parquet",
        "rel_lag_days": [1, 2, 3, 5, 10, 20],
        "use_macro": false
    },
    "model": {
        "type": "lightgbm_classifier",
        "params": {
            "n_estimators": 500, "max_depth": 3, "learning_rate": 0.05,
            "subsample": 0.8, "colsample_bytree": 0.8,
            "min_child_samples": 20, "reg_alpha": 0.0, "reg_lambda": 1.0,
            "early_stopping_rounds": 30
        }
    }
}
