# Python
__pycache__/
*/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb

# data/news/ is excluded — 3.6 GB (3,734 JSONL files), too large for git.
# Everything else in data/ IS tracked (parquet, csv, JSON features).
# Restore news: python data_tools/fetch_news_archive.py
# See notes/data_sources.md for full data inventory.
data/news/

# Temporary download archives
*.zip

# Model weights (always regenerable)
*.pkl
*.joblib

# Experiment artifacts — config.json and metrics.json are kept via git
# but model weights inside experiments/ are excluded above
# If you want to purge experiments entirely: uncomment next line
# experiments/

# Auto-generated logs — these ARE tracked (they record experiment history)
# results_summary.jsonl   <- TRACKED
# wf_results.jsonl        <- TRACKED
# xs_wf_results.jsonl     <- TRACKED

# Runtime job state and watchdog snapshots
artifacts/job_status/*.json
artifacts/job_status/*.jsonl

# Mutable latest pointers; keep timestamped summaries tracked
artifacts/run_summaries/latest_*.json

# Deprecated local checkpoint root; durable model checkpoints now live in data/
artifacts/news_models/

# Test scratch space
tests/.tmp/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
