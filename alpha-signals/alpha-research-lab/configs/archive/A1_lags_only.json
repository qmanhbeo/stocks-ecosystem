{
    "experiment_name": "A1_lags_only",
    "data": {
        "file_path": "gia_lich_su_FPT_1D.parquet",
        "target_col": "future_return_5d",
        "test_size": 0.15,
        "val_size": 0.15,
        "start_date": "2016-01-01"
    },
    "features": {
        "base_cols": [],
        "use_lags": true,
        "lag_days": [1, 2, 3, 5, 10, 20, 60],
        "use_ma": false,
        "use_ma_dist": false,
        "use_rsi": false,
        "use_macd": false,
        "use_bb": false,
        "use_atr": false,
        "use_volume_signals": false
    },
    "model": {
        "type": "xgboost",
        "params": {
            "n_estimators": 500,
            "max_depth": 4,
            "learning_rate": 0.05,
            "subsample": 0.8,
            "colsample_bytree": 0.8,
            "early_stopping_rounds": 30
        }
    }
}
